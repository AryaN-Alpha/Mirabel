# These are now OPTIONAL. Vite proxies /api and /ws to Django on :8000
# automatically (see vite.config.js). Only set these if you need to point
# the frontend at a different backend host (unusual).
VITE_API_URL=
VITE_WS_URL=

# Required for Tailscale remote access: set to your Tailscale machine FQDN
# (e.g. my-pc.tail1234.ts.net) so Vite accepts the Tailscale hostname in
# the Host header (HMR security check). Find it: tailscale status --self
VITE_ALLOWED_HOST=

# Optional. Only needed for testing the Outlook OAuth flow through a public
# tunnel (e.g. ngrok) instead of localhost -- see backend/.env.example's
# MS_REDIRECT_URI comment. Leave unset to use VITE_API_URL as normal.
VITE_OUTLOOK_API_URL=

# Required for local dev unless VITE_API_URL above is already 127.0.0.1.
# SPOTIFY_REDIRECT_URI in backend/.env must be 127.0.0.1 (Spotify's loopback
# exception requires that exact literal, not "localhost"), so the "Connect
# Spotify" link needs to start on that same origin too -- otherwise the
# session cookie holding the OAuth state is set on one origin (localhost)
# and the callback lands on another (127.0.0.1), which can't see it
# ("Invalid OAuth state"). Set this to http://127.0.0.1:8000.
VITE_SPOTIFY_API_URL=
