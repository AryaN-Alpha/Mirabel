DJANGO_SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=mirabel
DB_USER=postgres
# Required — no fallback. The app will refuse to start without it.
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Required — encrypts ProviderCredential.api_key at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
OPENAI_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional, Windows-only: set if ffmpeg isn't already on PATH (pydub/STT needs it).
FFMPEG_DIR=

# --- Celery / Redis ---
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
# Result backend is hardcoded to "django-db" in settings.py (stored in Postgres).
# Do NOT set CELERY_RESULT_BACKEND here — celery reads that raw env var directly
# and it overrides the Django-settings value regardless of config_from_object.
CELERY_TASK_ALWAYS_EAGER=False

# --- ChromaDB ---
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database

# --- Memory tuning ---
MEMORY_RETRIEVAL_TOP_K=6
MEMORY_RECENCY_HALF_LIFE_DAYS=30

# --- Voice pipeline ---
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
EDGE_TTS_VOICE=en-US-JennyNeural
EDGE_TTS_RATE=+5%
EDGE_TTS_PITCH=+2Hz

# --- Channels ---
CHANNEL_LAYER_REDIS_URL=redis://127.0.0.1:6379/3
