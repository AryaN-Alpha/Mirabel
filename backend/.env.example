DJANGO_SECRET_KEY=
DEBUG=True
# Add your ngrok host here too (e.g. "abc123.ngrok-free.dev") when using a
# tunnel for MS_REDIRECT_URI below -- Django rejects requests whose Host
# header isn't listed here.
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=mirabel
DB_USER=postgres
# Required — no fallback. The app will refuse to start without it.
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Required — encrypts ProviderCredential.api_key at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional, Windows-only: set if ffmpeg isn't already on PATH (pydub/STT needs it).
FFMPEG_DIR=

# --- Celery / Redis ---
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
# Result backend is hardcoded to "django-db" in settings.py (stored in Postgres).
# Do NOT set CELERY_RESULT_BACKEND here — celery reads that raw env var directly
# and it overrides the Django-settings value regardless of config_from_object.
CELERY_TASK_ALWAYS_EAGER=False

# --- ChromaDB ---
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database

# --- Memory tuning ---
MEMORY_RETRIEVAL_TOP_K=6
MEMORY_RECENCY_HALF_LIFE_DAYS=30

# --- Agent (LangGraph autonomous tool-calling agent, run via Celery) ---
# Reuses whichever provider/API key is set above via ModelPreference — no
# separate credentials needed. All optional; these are the defaults.
# Cap on tool-call steps per run (cost/DoS guard).
AGENT_MAX_STEPS=15
# Celery per-task time limits for agent runs — deliberately generous vs. the
# rest of this app's tasks (a multi-tool-call run needs minutes, not seconds).
AGENT_TASK_TIME_LIMIT=600
AGENT_TASK_SOFT_TIME_LIMIT=540
# Run the dedicated agent worker (single worker for now) with:
#   celery -A mirabel worker -Q agent --concurrency=1 --loglevel=info
# and run `python manage.py setup_agent_checkpointer` once per environment
# (alongside `migrate`) to create the LangGraph checkpoint tables.

# --- Voice pipeline ---
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
EDGE_TTS_VOICE=en-US-JennyNeural
EDGE_TTS_RATE=+5%
EDGE_TTS_PITCH=+2Hz

# --- Channels ---
CHANNEL_LAYER_REDIS_URL=redis://127.0.0.1:6379/3

# --- Outlook / Microsoft Graph integration ---
# Register an app at https://portal.azure.com > App registrations. Add a
# "Web" platform redirect URI matching MS_REDIRECT_URI below, and grant
# delegated Microsoft Graph permissions: Mail.Read, Mail.Send, User.Read,
# offline_access. Create a client secret under "Certificates & secrets".
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "common" allows both personal Microsoft accounts and any work/school
# tenant to sign in. Use a specific tenant GUID to restrict to one org.
MS_TENANT_ID=common
# Must exactly match a redirect URI registered on the Azure app. Azure
# requires this to be publicly reachable in most cases, so during local dev
# point it at a tunnel (e.g. `ngrok http 8000`) instead of localhost, and set
# frontend/.env's VITE_OUTLOOK_API_URL to the same tunnel URL so the OAuth
# session cookie stays on one origin.
MS_REDIRECT_URI=http://localhost:8000/api/outlook/auth/callback/
# Where the backend sends the browser after OAuth completes or fails.
FRONTEND_URL=http://localhost:5173
# The Inbox tab only returns messages whose sender's email domain matches this.
OUTLOOK_ALLOWED_SENDER_DOMAIN=dgtdata.com

# --- LinkedIn integration ---
# Create an app at https://www.linkedin.com/developers/apps, request the
# "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn"
# Products, then paste its values here. See README for the full walkthrough.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must exactly match a redirect URL registered on the LinkedIn app.
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/linkedin/auth/callback/
LINKEDIN_SCOPES=openid profile email w_member_social
# LinkedIn's date-versioned API header, format YYYYMM. LinkedIn only keeps a
# version active for ~12 months after release, then requests 426 with
# NONEXISTENT_VERSION — bump this periodically to a recent month.
LINKEDIN_API_VERSION=202608
# Standard self-serve LinkedIn apps do NOT get refresh tokens (partner-only
# program) — leave this False unless LinkedIn has granted your app that. See
# README for what this changes (an inert flag otherwise; expiry is handled
# via the "Reconnect LinkedIn" flow instead).
LINKEDIN_ENABLE_REFRESH_TOKEN=False
# FRONTEND_URL above is reused for the LinkedIn OAuth redirect too.

# --- Google Classroom integration ---
# 1. Create/select a project at https://console.cloud.google.com.
# 2. Enable these APIs under "APIs & Services > Library": Google Classroom
#    API, Google Drive API, Google Docs API.
# 3. Configure the OAuth consent screen ("APIs & Services > OAuth consent
#    screen"). IMPORTANT: while the app's Publishing status is "Testing"
#    (the default, and fine for personal use), ONLY Google accounts you
#    explicitly add under "Test users" can complete the OAuth flow — add your
#    own Google account there or every connect attempt will fail with
#    "access_denied". Publishing to production requires Google verification
#    for the drive.readonly scope below, which isn't worth pursuing for a
#    single-user personal app.
# 4. Under "Credentials", create an OAuth 2.0 Client ID of type
#    "Web application". Add GOOGLE_CLASSROOM_REDIRECT_URI below as an exact
#    Authorized redirect URI. Google accepts localhost redirect URIs directly
#    for local dev — no ngrok tunnel required, unlike the Outlook/Azure AD
#    integration above.
GOOGLE_CLASSROOM_CLIENT_ID=
GOOGLE_CLASSROOM_CLIENT_SECRET=
GOOGLE_CLASSROOM_REDIRECT_URI=http://localhost:8000/api/classroom/auth/callback/
# Space-separated scopes. drive.readonly below is broad — it grants read
# access to the connected user's ENTIRE Drive (Google doesn't offer a
# narrower "Classroom-attachments-only" read scope), needed only to read the
# text of teacher-provided Google Doc attachments so the AI can use them as
# context. drive.file + documents (narrower — app-created files only) create
# and write the solution Doc attached on turn-in for ASSIGNMENT-type
# coursework.
GOOGLE_CLASSROOM_SCOPES=openid https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile https://www.googleapis.com/auth/classroom.courses.readonly https://www.googleapis.com/auth/classroom.coursework.me https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/documents
# FRONTEND_URL above is reused for the Classroom OAuth redirect too.
